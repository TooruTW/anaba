# 複製成 .env.local 後填值；Vercel 上在 Project Settings → Environment Variables 填同樣的名稱
# NEXT_PUBLIC_ 開頭的會打包進前端，任何人都看得到，不能放秘密

# 資料庫連線字串（Supabase → Connect → Transaction pooler，port 6543）
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# 註冊用邀請碼
INVITE_CODE=

# 管理 API 的 Bearer token（見 DOC/admin-api.md），用長隨機字串
ADMIN_TOKEN=

# 顯示給使用者的聯絡信箱
NEXT_PUBLIC_CONTACT_EMAIL=

# 台灣圖資 pmtiles 網址（R2）
NEXT_PUBLIC_PMTILES_URL=https://pub-<id>.r2.dev/taiwan.pmtiles
